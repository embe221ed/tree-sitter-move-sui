{
  "name": "tree-sitter-move",
  "version": "1.0.0",
  "description": "Tree-sitter parser for the Sui dialect of the Move language",
  "license": "Apache-2.0",
  "main": "bindings/node",
  "types": "bindings/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embe221ed/tree-sitter-move-sui.git"
  },
  "scripts": {
    "generate": "tree-sitter generate --abi 15",
    "test": "./run-tests.sh",
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip",
    "test:node": "node-gyp rebuild && node --test bindings/node/*_test.js",
    "test:fuzz": "tree-sitter fuzz --iterations 20 --edits 4",
    "test:types": "tsc --noEmit --strict --target es2022 --module node16 --moduleResolution node16 --types node bindings/node/binding_test.ts"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prebuildify": "^6.0.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.27.1",
    "typescript": "7.0.2"
  },
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ]
}
